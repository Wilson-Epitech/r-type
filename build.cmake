set(VCPKG_ROOT "${CMAKE_SOURCE_DIR}/build/vcpkg")

if(NOT DEFINED VCPKG_TARGET_TRIPLET)
    if(UNIX AND NOT APPLE)
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64")
            set(VCPKG_TARGET_TRIPLET "x64-linux")
        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64")
            set(VCPKG_TARGET_TRIPLET "arm64-linux")
        endif()
    elseif(APPLE)
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "arm64")
            set(VCPKG_TARGET_TRIPLET "arm64-osx")
        else()
            set(VCPKG_TARGET_TRIPLET "x64-osx")
        endif()
    elseif(WIN32)
        if(CMAKE_SYSTEM_PROCESSOR MATCHES "AMD64")
            set(VCPKG_TARGET_TRIPLET "x64-windows")
        elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86")
            set(VCPKG_TARGET_TRIPLET "x86-windows")
        endif()
    endif()
endif()

if(NOT EXISTS "${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
    message(STATUS "Downloading vcpkg...")
    execute_process(COMMAND git clone https://github.com/microsoft/vcpkg.git ${VCPKG_ROOT})
    if(UNIX)
        execute_process(COMMAND ${VCPKG_ROOT}/bootstrap-vcpkg.sh WORKING_DIRECTORY ${VCPKG_ROOT})
    elseif(WIN32)
        execute_process(COMMAND ${VCPKG_ROOT}/bootstrap-vcpkg.bat WORKING_DIRECTORY ${VCPKG_ROOT})
    endif()
    execute_process(COMMAND ${VCPKG_ROOT}/vcpkg integrate install)
    execute_process(COMMAND ${VCPKG_ROOT}/vcpkg install raylib asio glfw3)
endif()

if(NOT EXISTS "build/clean.cmake")
    execute_process(COMMAND touch build/clean.cmake)
    file(APPEND "build/clean.cmake" "if (UNIX)\n")
    file(APPEND "build/clean.cmake" "    set(DOCS ./build/CMakeCache.txt ./build/Makefile ./build/cmake_install.cmake ./build/CMakeFiles ./build/src ./rtype_client ./rtype_server)\n\n")
    file(APPEND "build/clean.cmake" "    foreach(DOC \${DOCS})\n")
    file(APPEND "build/clean.cmake" "        execute_process(COMMAND rm -rf ./\${DOC})\n")
    file(APPEND "build/clean.cmake" "    endforeach()\n\n")
    file(APPEND "build/clean.cmake" "    if (APPLE)\n")
    file(APPEND "build/clean.cmake" "        set (LIBS ./sharedLibraries/libclient.dylib ./sharedLibraries/libserver.dylib)\n\n")
    file(APPEND "build/clean.cmake" "        foreach(LIB \${LIBS})\n")
    file(APPEND "build/clean.cmake" "            execute_process(COMMAND rm -rf ./\${LIB})\n")
    file(APPEND "build/clean.cmake" "        endforeach()\n\n")
    file(APPEND "build/clean.cmake" "    elseif (NOT APPLE)\n")
    file(APPEND "build/clean.cmake" "        set (LIBS ./sharedLibraries/libclient.so ./sharedLibraries/libserver.so)\n\n")
    file(APPEND "build/clean.cmake" "        foreach(LIB \${LIBS})\n")
    file(APPEND "build/clean.cmake" "            execute_process(COMMAND rm -rf ./\${LIB})\n")
    file(APPEND "build/clean.cmake" "        endforeach()\n")
    file(APPEND "build/clean.cmake" "    endif ()\n")
    file(APPEND "build/clean.cmake" "endif ()\n")
endif()

if (UNIX)
    execute_process(COMMAND cmake -B build -S . -DCMAKE_TOOLCHAIN_FILE=build/vcpkg/scripts/buildsystems/vcpkg.cmake)
elseif(WIN32)
    execute_process(COMMAND cmake -B build -S . -G "MinGW Makefiles" -DCMAKE_CXX_COMPILER=g++ -DCMAKE_C_COMPILER=gcc -DCMAKE_TOOLCHAIN_FILE='build/vcpkg/scripts/buildsystems/vcpkg.cmake')
endif()